{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window"]
  },
  "tasks": {
    "protoc": "protoc.sh",
    "start": "deno run --allow-net --allow-import --allow-write --allow-read --allow-env --watch ./src/main.ts",
    "exec": "deno run --allow-net --allow-import --allow-write --allow-read --allow-env ./src/main.ts",
    "test": "deno test --allow-import --no-check src/module/feature/unit_test.ts"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
    "@std/log": "jsr:@std/log@^0.224.7"
  }
}
